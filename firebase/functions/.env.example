# Copy this file to .env (in the same directory) and fill in the values
# before running the emulator or deploying.
#
# NEVER commit .env to Git. The .gitignore at the repo root already excludes
# .env and .env.* files.
#
# How to use with the Firebase emulator:
#   1. cp .env.example .env
#   2. Fill in the values below
#   3. Run: firebase emulators:start   (from inside the firebase/ directory)
#
# In production, store only the server secrets identified below with
# `firebase functions:secrets:set SECRET_NAME`; those names are bound in
# `src/index.js`. Required non-secret runtime values are ordinary environment
# variables. OTP policy and WhatsApp template identity belong in the
# `business_config/main` Firestore document, not in this file.

# ─── WhatsApp Cloud API ─────────────────────────────────────────────────────
# Secret Manager secret: Meta App Secret used to verify x-hub-signature-256
WHATSAPP_APP_SECRET=

# Secret Manager secret: arbitrary verify token set in Meta webhook configuration;
# must match exactly what the webhook endpoint checks during the handshake
WHATSAPP_VERIFY_TOKEN=

# Required ordinary environment value: WhatsApp Business Account phone number ID
WHATSAPP_PHONE_NUMBER_ID=

# Required ordinary environment value: explicit Meta Graph API version (e.g. vXX.X)
WHATSAPP_GRAPH_API_VERSION=

# Secret Manager secret: Meta permanent access/system-user token
WHATSAPP_ACCESS_TOKEN=

# ─── Razorpay ───────────────────────────────────────────────────────────────
# Required ordinary environment value: Razorpay API Key ID
RAZORPAY_KEY_ID=

# Secret Manager secret: Razorpay API Key Secret
RAZORPAY_KEY_SECRET=

# Secret Manager secret used to verify x-razorpay-signature
RAZORPAY_WEBHOOK_SECRET=

# ─── Driver OTP ─────────────────────────────────────────────────────────────
# Secret Manager secret: server-only pepper mixed into every scrypt derivation.
# Operational limits belong in business_config/main.otpPolicy, not here.
OTP_PEPPER=

# ─── Ola Maps ───────────────────────────────────────────────────────────────
# Future Phase 4 server secret: Ola Maps routing/matrix/geocoding key. Never expose to clients.
OLA_MAPS_API_KEY=

# ─── Mapbox ─────────────────────────────────────────────────────────────────
# Mapbox public access token — used by the Flutter driver app (Part 1 only).
# Not used by Cloud Functions, but documented here for discoverability.
# Set this in the Flutter app's environment config (Phase 5), not here.
# MAPBOX_ACCESS_TOKEN=
