# Copy this file to .env (in the same directory) and fill in the values
# before running the emulator or deploying.
#
# NEVER commit .env to Git. The .gitignore at the repo root already excludes
# .env and .env.* files.
#
# How to use with the Firebase emulator:
#   1. cp .env.example .env
#   2. Fill in the values below
#   3. Run: firebase emulators:start   (from inside the firebase/ directory)
#
# In production, set these as Firebase Functions environment config:
#   firebase functions:secrets:set SECRET_NAME   (recommended — uses Secret Manager)
# or (legacy):
#   firebase functions:config:set section.key="value"

# ─── WhatsApp Cloud API ─────────────────────────────────────────────────────
# Meta App Secret — used to verify x-hub-signature-256 on incoming webhooks
WHATSAPP_APP_SECRET=

# Verify token — arbitrary string you set in the Meta webhook configuration;
# must match exactly what the webhook endpoint checks during the handshake
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Business Account phone number ID (from Meta Business Suite)
WHATSAPP_PHONE_NUMBER_ID=

# Meta permanent access token (or system user token) for sending messages
WHATSAPP_ACCESS_TOKEN=

# ─── Razorpay ───────────────────────────────────────────────────────────────
# Razorpay API Key ID (not secret — also used client-side for UPI Intent)
RAZORPAY_KEY_ID=

# Razorpay API Key Secret — server-side only
RAZORPAY_KEY_SECRET=

# Webhook secret used to verify x-razorpay-signature on incoming events
RAZORPAY_WEBHOOK_SECRET=

# ─── Ola Maps ───────────────────────────────────────────────────────────────
# Ola Maps API key for towing routing/matrix/geocoding. Never exposed to client.
OLA_MAPS_API_KEY=

# ─── Mapbox ─────────────────────────────────────────────────────────────────
# Mapbox public access token — used by the Flutter driver app (Part 1 only).
# Not used by Cloud Functions, but documented here for discoverability.
# Set this in the Flutter app's environment config (Phase 5), not here.
# MAPBOX_ACCESS_TOKEN=
